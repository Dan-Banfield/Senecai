# Copy to web/.env.local (gitignored) to use a Supabase song market locally.
# Leave unset to keep the market in this browser's IndexedDB.
# Both values are public (they ship in the browser bundle); RLS protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
